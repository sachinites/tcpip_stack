#ifndef __EVPN__
#define __EVPN__

#include <stdint.h>
#include "../Interface/InterfaceFwd.h"


typedef struct vlan_vni_mapping_ {

        uint16_t vlan_id; 
        uint16_t vni; 
        uint32_t mcast_group;
        struct vlan_vni_mapping_ *next;

} vlan_vni_mapping_t;

typedef struct l3vni_ {
    
        uint16_t l3vni; 
        struct l3vni_ *next;
} l3vni_t;

/*
Example : 
interface nve1
  no shutdown
  source-interface loopback0
  host-reachability protocol bgp

  member vni 101 associate-vrf       ! Tenant A IP VRF
  member vni 5010 mcast-group 239.1.1.1   ! Tenant A MAC-VRF (VLAN 10)
  member vni 5020 mcast-group 239.2.2.2   ! Tenant A MAC-VRF (VLAN 20)

  member vni 102 associate-vrf       ! Tenant B IP VRF
  member vni 5030 mcast-group 239.3.3.3   ! Tenant B MAC-VRF (VLAN 20)
  member vni 5040 mcast-group 239.4.4.4   ! Tenant B MAC-VRF (VLAN 40)
*/
typedef struct nve_if_{

    bool shutdown;
    InterfaceP source_intf;
    vlan_vni_mapping_t *vlan_vni_mapping; 
    l3vni_t *l3vni; 

} nve_t;


typedef struct replication_ {

    nve_if_t *nve_if;      // Only one instance per node
    uint32_t dst_ip;

} replication_t;

typedef struct evpn_bum_global_mac_address_table {

    uint16_t l3vni;  // key1
    uint16_t l2vni;  // key2
    replication_t *replication; // value

} evpn_bum_global_mac_address_table_t;




#endif 