#ifndef __EVPN__
#define __EVPN__

#include <stdint.h>
#include "../vrf/vrf.h"
#include "../Interface/InterfaceFwd.h"


typedef struct vlan_vni_mapping_ {

        uint16_t vlan_id; 
        uint16_t vni; 
        uint32_t mcast_group;
        struct vlan_vni_mapping_ *next;

} vlan_vni_mapping_t;

typedef struct l3vni_ {
    
        uint16_t l3vni; 
        struct l3vni_ *next;
} l3vni_t;

/*
Example : 
interface nve1
  no shutdown
  source-interface loopback0
  host-reachability protocol bgp

  member vni 101 associate-vrf       ! Tenant A IP VRF
  member vni 5010 mcast-group 239.1.1.1   ! Tenant A MAC-VRF (VLAN 10)
  member vni 5020 mcast-group 239.2.2.2   ! Tenant A MAC-VRF (VLAN 20)

  member vni 102 associate-vrf       ! Tenant B IP VRF
  member vni 5030 mcast-group 239.3.3.3   ! Tenant B MAC-VRF (VLAN 20)
  member vni 5040 mcast-group 239.4.4.4   ! Tenant B MAC-VRF (VLAN 40)
*/
typedef struct nve_if_{

    bool shutdown;
    InterfaceP source_intf;
    vlan_vni_mapping_t *vlan_vni_mapping; 
    l3vni_t *l3vni; 

} nve_t;


typedef struct replication_ {

    nve_if_t *nve_if;      // Only one instance per node
    uint32_t dst_ip;

} replication_t;

typedef struct evpn_bum_global_mac_address_table {

    uint16_t l3vni;  // key1
    uint16_t l2vni;  // key2
    replication_t *replication; // value

} evpn_bum_global_mac_address_table_t;

typedef enum evpn_rt_type_ {

    EVPN_RT_TYPE_MAC_IP_ADVERTISEMENT = 2,
    EVPN_RT_TYPE_INCLUSIVE_MULTICAST_ETHERNET_TAG = 3,
    EVPN_RT_TYPE_ETHERNET_SEGMENT = 4,
    EVPN_RT_TYPE_IP_PREFIX_ROUTE = 5

} evpn_rt_type_t;


/* BGP EVPN Route structure , to be stored in BGP EVPN RIB
Ex : 
Route Distinguisher: 10.0.0.1:32777

 *>i [2]:[0]:[48]:[00:50:79:66:68:00]
                    10.0.0.1                      100      0 i
                    RT:65501:10 ET:8
 *>i [2]:[0]:[48]:[00:50:79:66:68:00]:[32]:[192.168.10.10]
                    10.0.0.1                      100      0 i
                    RT:65501:10 RT:65501:99999 ET:8 Rmac:0c:e4:00:00:1b:08
*/
typedef struct bgp_evpn_route_ {
    
    evpn_rt_type_t rt_type;
    mac_addr_t mac_addr;
    uint8_t prefix_len;
    uint32_t prefix;
    uint32_t leaf_ip;
    rt_t mac_vrf_rt;
    rt_t ip_vrf_rt;
    mac_addr_t rmac;

} evpn_route_t;

#endif 