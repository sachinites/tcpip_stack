:INFO: Base Config done

:CMD: config R0 no protocol isis interface eth1
:CMD: config R0 no interface ethernet eth1 ip-address 192.168.0.2 24
:CMD: config R0 no interface ethernet eth1 vrf 0
:CMD: config R0 distributed-anycast-gateway 00:02:00:02:00:02
:CMD: config R0 bridge-domain 10
:CMD: config R0 interface ethernet eth1 switchport
:CMD: config R0 bridge-domain 10 member eth1 encapsulation dot1q 10

:CMD: config R3 no protocol isis interface eth1
:CMD: config R3 no interface ethernet eth1 ip-address 192.168.0.2 24
:CMD: config R3 no interface ethernet eth1 vrf 0
:CMD: config R3 distributed-anycast-gateway 00:02:00:02:00:02
:CMD: config R3 bridge-domain 10
:CMD: config R3 interface ethernet eth1 switchport
:CMD: config R3 bridge-domain 10 member eth1 encapsulation dot1q 10

:CMD: config CE1 interface loopback 0
:CMD: config CE1 interface loopback 0 up
:CMD: config CE1 interface loopback 0 ip-address 10.0.0.1 32
:CMD: config CE1 no interface ethernet eth1 ip-address 172.168.0.1 24
:CMD: config CE1 no interface ethernet eth1 vrf 0
:CMD: config CE1 interface ethernet eth1 switchport
:CMD: config CE1 interface vlan 10
:CMD: config CE1 interface ethernet eth1 vlan 10
:CMD: config CE1 no interface ethernet eth0 ip-address 192.168.0.1 24
:CMD: config CE1 no interface ethernet eth0 vrf 0
:CMD: config CE1 interface ethernet eth0 switchport
:CMD: config CE1 transport-service-profile tsp10
:CMD: config CE1 transport-service-profile tsp10 vlan 10
:CMD: config CE1 interface ethernet eth0 transport-service-profile tsp10

:CMD: config CE2 interface loopback 0
:CMD: config CE2 interface loopback 0 up
:CMD: config CE2 interface loopback 0 ip-address 10.0.0.1 32
:CMD: config CE2 no interface ethernet eth1 ip-address 172.168.0.1 24
:CMD: config CE2 no interface ethernet eth1 vrf 0
:CMD: config CE2 interface ethernet eth1 switchport
:CMD: config CE2 interface vlan 10
:CMD: config CE2 interface ethernet eth1 vlan 10
:CMD: config CE2 no interface ethernet eth0 ip-address 192.168.0.1 24
:CMD: config CE2 no interface ethernet eth0 vrf 0
:CMD: config CE2 interface ethernet eth0 switchport
:CMD: config CE2 transport-service-profile tsp10
:CMD: config CE2 transport-service-profile tsp10 vlan 10
:CMD: config CE2 interface ethernet eth0 transport-service-profile tsp10

:CMD: config CE2 no interface ethernet eth2 vrf 0
:CMD: config CE2 interface ethernet eth2 switchport
:CMD: config CE2 interface ethernet eth2 vlan 10


:CMD: config H1 no interface ethernet eth1 ip-address 172.168.0.2 24
:CMD: config H1 interface ethernet eth1 ip-address 172.168.0.1 24
:CMD: config H1 rtm-route prefix 0.0.0.0/0 0 0 0 2 0 gateway 172.168.0.254 interface eth1

:CMD: config H2 rtm-route prefix 0.0.0.0/0 0 0 0 2 0 gateway 172.168.0.254 interface eth1

:CMD: config H3 interface ethernet eth1 ip-address 172.168.0.3 24
:CMD: config H3 interface ethernet eth1 up
:CMD: config H3 rtm-route prefix 0.0.0.0/0 0 0 0 2 0 gateway 172.168.0.254 interface eth1



