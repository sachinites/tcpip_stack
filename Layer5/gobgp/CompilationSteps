#--------------------------------------------------------------------#
3. Steps to build test.exe ( sample test program and libgrpc_wrapper.a )
#--------------------------------------------------------------------#

export GOBGP_SRC="$HOME/OpenSrc-Codes/GoBGP/gobgp"
export APP_DIR="$HOME/GitProjects/tcpip_stack/Layer5/gobgp/gobgp-grpc"

cd "$APP_DIR"

rm -rf generated build
rm -f libgrpc_wrapper.a test.exe

mkdir -p generated build

cd "$GOBGP_SRC/proto"

protoc \
    -I. \
    --cpp_out="$APP_DIR/generated" \
    api/*.proto

protoc \
    -I. \
    --grpc_out="$APP_DIR/generated" \
    --plugin=protoc-gen-grpc="$(command -v grpc_cpp_plugin)" \
    api/gobgp.proto

cd "$APP_DIR"

g++ -std=c++17 \
    -Wall \
    -Wextra \
    -O2 \
    -I./generated \
    $(pkg-config --cflags grpc++ protobuf) \
    -c gobgp_grpc.cpp \
    -o build/gobgp_grpc.o

for src in generated/api/*.pb.cc; do
    obj="build/$(basename "${src%.cc}").o"

    echo "Compiling $src"

    g++ -std=c++17 \
        -Wall \
        -Wextra \
        -O2 \
        -I./generated \
        $(pkg-config --cflags grpc++ protobuf) \
        -c "$src" \
        -o "$obj" || exit 1
done

ar rcs libgrpc_wrapper.a build/*.o

g++ -std=c++17 \
    -Wall \
    -Wextra \
    -O2 \
    -I. \
    -I./generated \
    $(pkg-config --cflags grpc++ protobuf) \
    test.cpp \
    -L. \
    -Wl,--start-group \
    -lgrpc_wrapper \
    $(pkg-config --libs --static grpc++ protobuf) \
    -Wl,--end-group \
    -ldl \
    -pthread \
    -o test.exe

ls -lh libgrpc_wrapper.a test.exe